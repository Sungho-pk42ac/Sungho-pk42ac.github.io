---
import { Image } from 'astro:assets'
import { formatDate, type Post } from '../lib/posts'

interface Props {
  post: Post
}

const { post } = Astro.props
const { title, date, description, tags, thumbnail } = post.data
const href = `/posts/${post.id}/`
---

<article class="post-card">
  {
    thumbnail && (
      <a href={href} class="post-card__thumb">
        {/* 빌드 시 webp 로 변환·리사이즈. 카드 폭(768) 기준 */}
        <Image src={thumbnail} alt="" width={768} densities={[1, 2]} />
      </a>
    )
  }
  <div class="post-card__body">
    <h2 class="post-card__title"><a href={href}>{title}</a></h2>
    {description && <p class="post-card__desc">{description}</p>}
    <div class="post-card__meta">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {tags.length > 0 && (
        <ul class="post-card__tags">
          {tags.map((t) => <li>{t}</li>)}
        </ul>
      )}
    </div>
  </div>
</article>
