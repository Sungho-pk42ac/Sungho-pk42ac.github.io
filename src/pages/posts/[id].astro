---
import { render } from 'astro:content'
import SeriesNav from '../../components/SeriesNav.astro'
import Toc from '../../components/Toc.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { formatDate, getPublishedPosts } from '../../lib/posts'
import { tagHref } from '../../lib/tags'
import '../../styles/markdown.css'

export async function getStaticPaths() {
  const posts = await getPublishedPosts()
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content, headings } = await render(post)
---

<BaseLayout title={post.data.title} description={post.data.description} type="article">
  <div class="post-layout">
    {/* data-pagefind-body: 검색 색인은 글 본문(제목 포함)만. 헤더·목차·시리즈 내비는 제외 */}
    <article data-pagefind-body>
      <h1 class="post__title">{post.data.title}</h1>
      <p class="post__date">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      </p>
      {
        post.data.tags.length > 0 && (
          <ul class="post__tags">
            {post.data.tags.map((t) => (
              <li>
                <a href={tagHref(t)}>{t}</a>
              </li>
            ))}
          </ul>
        )
      }
      <div class="post__body markdown-body">
        <Content />
      </div>
      <div data-pagefind-ignore>
        <SeriesNav post={post} />
      </div>
    </article>
    <aside class="post-layout__aside">
      <Toc headings={headings} />
    </aside>
  </div>
</BaseLayout>

<script>
  // 스크롤 스파이 — 뷰포트 상단 20% 지점을 지난 제목 중 가장 아래 것의 목차 항목에 .is-active
  const pairs = [...document.querySelectorAll<HTMLAnchorElement>('nav.toc a')]
    .map((a) => [document.getElementById(decodeURIComponent(a.hash.slice(1))), a] as const)
    .filter((p): p is readonly [HTMLElement, HTMLAnchorElement] => p[0] !== null)
  if (pairs.length) {
    let active: HTMLAnchorElement | undefined
    const update = () => {
      // offsetTop 은 position:relative 조상 기준이라 문서 좌표가 아니다. 뷰포트 좌표로 비교한다
      const line = window.innerHeight * 0.2
      const [, a] = pairs.filter(([h]) => h.getBoundingClientRect().top <= line).at(-1) ?? pairs[0]
      if (a === active) return
      active?.classList.remove('is-active')
      a.classList.add('is-active')
      active = a
    }
    // IntersectionObserver 는 교차 '변화'만 알려서 앵커 점프(목차 클릭)처럼 띠를 한 번에 건너뛰면 안 울린다.
    // 제목 열몇 개 rect 계산은 싸므로 그냥 scroll 마다 돈다
    addEventListener('scroll', update, { passive: true })
    update()
  }
</script>
